<?xml version="1.0"?>
<package format="3">
  <name>create_fundamentals</name>
  <version>1.0.0</version>
  <description>create_fundamentals is a ROS 2 package for fundamental create functionality.</description>
  <maintainer email="v.mengers@tu-berlin.de">Vito Mengers</maintainer>
  <license>BSD</license>
  <author>Rico Jonschkowski, Furkan Davulcu, Patrick Lowin, Vito Mengers</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <depend>rclpy</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>laser_filters</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>urg_node</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
